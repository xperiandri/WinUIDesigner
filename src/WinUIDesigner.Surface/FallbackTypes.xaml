<!--
    This dictionary is never loaded. It exists for the XAML compiler: a type gets an entry in the generated XAML
    metadata only when compiled markup mentions it, and XamlReader.Load finds a type of this process that prepared
    XAML names through that metadata alone.

    When the types of a project are not known to Visual Studio yet (the first documents of a session), it prepares a
    dictionary with its own stand-ins in place of the converters and selectors of the project:
    {using:XSurfUwp.Fallback}FallbackValueConverter and the selectors. Without these entries the reader rejects the
    whole copy ("The type 'FallbackValueConverter' was not found") and every converter of the dictionary is left out.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:fallback="using:XSurfUwp.Fallback">
    <fallback:FallbackValueConverter x:Key="FallbackValueConverter" />
    <fallback:FallbackDataTemplateSelector x:Key="FallbackDataTemplateSelector" />
    <fallback:FallbackGroupStyleSelector x:Key="FallbackGroupStyleSelector" />
    <fallback:FallbackStyleSelector x:Key="FallbackStyleSelector" />
</ResourceDictionary>
